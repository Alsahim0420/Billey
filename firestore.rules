rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLinkedPartnerOf(otherUserDoc) {
      return isSignedIn()
          && otherUserDoc.data.coupleId != null
          && exists(/databases/$(database)/documents/couples/$(otherUserDoc.data.coupleId))
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(otherUserDoc.data.coupleId)).data.memberUids;
    }

    match /users/{userId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == userId || isLinkedPartnerOf(resource));

      allow delete: if isSignedIn() && request.auth.uid == userId;

      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && request.resource.data.uid == request.auth.uid;

      match /transactions/{transactionId} {
        allow read: if isSignedIn()
                    && (request.auth.uid == userId
                        || request.auth.uid in resource.data.sharedWith);

        allow create: if isSignedIn()
                      && request.auth.uid == userId
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.id == transactionId;

        allow update: if isSignedIn()
                      && request.auth.uid == userId
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.id == transactionId;

        allow delete: if isSignedIn()
                      && request.auth.uid == userId
                      && resource.data.userId == request.auth.uid;
      }

      match /goals/{goalId} {
        allow read: if isSignedIn()
                    && (request.auth.uid == userId
                        || request.auth.uid in resource.data.sharedWith);

        allow create: if isSignedIn()
                      && request.auth.uid == userId
                      && request.resource.data.userId == request.auth.uid;

        allow update: if isSignedIn()
                      && request.auth.uid == userId
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == request.auth.uid;

        allow delete: if isSignedIn()
                      && request.auth.uid == userId
                      && resource.data.userId == request.auth.uid;
      }
    }

    // Couple links and pairing codes are only ever written by Cloud
    // Functions via the Admin SDK (which bypasses these rules), so client
    // writes are always denied here. Members may read their own couple
    // link; pairing codes are never client-readable.
    match /couples/{coupleId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    match /pairingCodes/{code} {
      allow read, write: if false;
    }
  }
}
